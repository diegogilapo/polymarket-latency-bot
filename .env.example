# ==========================================
# CONFIGURACIÓN GENERAL DEL BOT
# ==========================================
# Modo Simulación / Paper Trading (True = Demo sin dinero real, False = Dinero Real)
SIMULATION_MODE=True

# Balance inicial virtual para Paper Trading (en USDC)
SIMULATION_INITIAL_BALANCE=1000.0

# Penalización de latencia de red simulada en milisegundos (ej. 25ms para simular viaje de ida y vuelta a servidores)
SIMULATED_NETWORK_LATENCY_MS=25

# ==========================================
# PARÁMETROS DE TRADING Y ARBITRAJE
# ==========================================
# Discrepancia mínima de precio requerida para disparar una orden (en USDC, ej: 0.05 = 5 centavos)
MIN_PRICE_DISCREPANCY=0.04

# Tamaño de cada orden por operación (en USDC)
ORDER_SIZE_USDC=50.0

# Take Profit objetivo sobre el precio de entrada (ej: 0.10 = +10 centavos de ganancia por acción)
TAKE_PROFIT_DELTA=0.08

# Stop Loss máximo permitido (ej: 0.06 = si cae 6 centavos por debajo de la entrada, cerrar)
STOP_LOSS_DELTA=0.06

# Tiempo máximo de espera en segundos para cerrar posición si el mercado no reacciona (Timeout)
POSITION_TIMEOUT_SECONDS=45

# ==========================================
# FEED Y MERCADOS
# ==========================================
# Ventana de tiempo (en segundos) para calcular velocidad/impulso de BTC
BTC_MOMENTUM_WINDOW_SECONDS=5.0

# Umbral de movimiento rápido de BTC en dólares para considerar un impulso fuerte (ej: $50 en 5s)
BTC_FAST_MOVE_THRESHOLD_USD=30.0

# Filtro de búsqueda para encontrar mercados activos de Bitcoin en Polymarket
POLYMARKET_SEARCH_KEYWORDS=Bitcoin,BTC

# ==========================================
# CREDENCIALES POLYMARKET (Solo requeridas si SIMULATION_MODE=False)
# ==========================================
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PROXY_WALLET=
