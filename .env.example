# ==========================================
# CONFIGURACIÓN GENERAL DEL BOT
# ==========================================
# Modo Simulación / Paper Trading (True = Demo sin dinero real, False = Dinero Real)
SIMULATION_MODE=True

# Balance inicial virtual para Paper Trading (en USDC)
SIMULATION_INITIAL_BALANCE=1000.0

# Penalización de latencia de red simulada en milisegundos
SIMULATED_NETWORK_LATENCY_MS=25

# ==========================================
# PARÁMETROS DE TRADING Y ARBITRAJE
# ==========================================
# Discrepancia mínima de precio requerida para disparar una orden (en USDC, ej: 0.04 = 4 centavos)
MIN_PRICE_DISCREPANCY=0.04

# Tamaño de cada orden por operación (en USDC)
ORDER_SIZE_USDC=50.0

# Take Profit objetivo sobre el precio de entrada (+8¢ de ganancia)
TAKE_PROFIT_DELTA=0.08

# Stop Loss máximo permitido (-6¢)
STOP_LOSS_DELTA=0.06

# Tiempo máximo en segundos para cerrar posición si el mercado se reequilibra
POSITION_TIMEOUT_SECONDS=45

# ==========================================
# ACTIVOS Y FEEDS MULTI-CRIPTO
# ==========================================
# Criptomonedas a monitorizar simultáneamente en exchanges
MONITORED_ASSETS=BTC,ETH,SOL,DOGE,XRP

# Ventana de tiempo (en segundos) para calcular velocidad/impulso de cada cripto
MOMENTUM_WINDOW_SECONDS=5.0

# Movimiento porcentual mínimo en la ventana para considerar un salto rápido (0.0005 = 0.05%)
FAST_MOVE_PCT_THRESHOLD=0.0005

# Palabras clave para auto-descubrimiento en Polymarket
POLYMARKET_SEARCH_KEYWORDS=Bitcoin,BTC,Ethereum,ETH,Solana,SOL,Dogecoin,DOGE,XRP,Crypto

# ==========================================
# CREDENCIALES POLYMARKET (Solo si SIMULATION_MODE=False)
# ==========================================
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
